[Unit]
Description=LyricFlow AI Web Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lyricflow
ExecStart=/usr/bin/python3 -u /opt/lyricflow/server.py
EnvironmentFile=/etc/lyricflow.env
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=3
User=lyricflow
Group=lyricflow
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lyricflow
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
